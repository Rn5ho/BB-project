# Copy this to .env.local and fill in your Supabase values
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (for server-side API routes — bypasses RLS)
# Get from: Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# BB API credentials (get security code from BB Settings > BBAPI)
BB_API_USERNAME=your-bb-username
BB_API_SECURITY_CODE=your-security-code
