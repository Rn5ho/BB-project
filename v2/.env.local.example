DATABASE_URL=
APP_PASSWORD=
APP_SESSION_SECRET=
# optional read-only community access — unset/empty disables guest login entirely.
# Rotating it stops NEW guest logins; issued guest sessions last up to 7 days
# (hard cut-off for everyone incl. owner: rotate APP_SESSION_SECRET).
GUEST_PASSWORD=
# migration-script only:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BB_API_USERNAME=
BB_API_SECURITY_CODE=
# census worker wake channel (shared secret; same value on Vercel and Hetzner):
CENSUS_WAKE_SECRET=
# app side only — where to ping on enqueue:
CENSUS_WAKE_URL=http://65.21.178.90:8791/wake
# worker side only — listen port and safety-net poll (default 30 min; keep it well
# above Neon's ~5 min scale-to-zero or the compute never suspends):
CENSUS_WAKE_PORT=8791
CENSUS_POLL_MS=1800000
