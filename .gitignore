# Claude Code local config (machine-specific: permissions, locks).
# EXCEPTION: v2/.claude/skills/ holds PROJECT skills — shared build/verify recipes that
# are project artifacts, not local config. They are force-added and tracked; once tracked,
# .gitignore no longer applies to them. Standing policy: nothing project-related lives
# local-only except secrets.
.claude/

# Dependencies
web/node_modules/

# Next.js
web/.next/
web/out/

# Environment files (contain secrets)
web/.env.local
web/.env*.local

# OS files
.DS_Store
Thumbs.db

# Vercel
web/.vercel

# TypeScript
*.tsbuildinfo
web/next-env.d.ts
.superpowers/
